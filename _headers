# Cloudflare Pages 自定义响应头（部署时自动生效，无需构建配置）
# 音乐文件内容固定不变（改名=新 URL），给一年强缓存：
# 回头客第二次访问直接读本地/边缘缓存，秒开且不耗流量
/music/*
  Cache-Control: public, max-age=31536000, immutable

# 本地依赖库基本不变，同样给长缓存
/libs/*
  Cache-Control: public, max-age=2592000

# 图片头像等静态资源（_headers 不支持路径中间的通配符，按文件列出）
/00.jpg
  Cache-Control: public, max-age=604800
/github.webp
  Cache-Control: public, max-age=604800
/bilibili.webp
  Cache-Control: public, max-age=604800
/icon-play.png
  Cache-Control: public, max-age=604800
/icon-pause.webp
  Cache-Control: public, max-age=604800
# HTML 与核心脚本/样式：每次都向服务器验证版本，杜绝新旧混用
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/main.js
  Cache-Control: public, max-age=0, must-revalidate
/style.css
  Cache-Control: public, max-age=0, must-revalidate